<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.RainHubPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="1400" d:DesignWidth="800"
      Title="RainHubPage"
      Scrollable="True"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <ui:UiPage.Resources>
        <!--
            Rows draw their own border, background and spacing, so the list container's own
            chrome is removed. Otherwise every row picks up the theme's hover and selection
            highlight on top of it.
        -->
        <Style x:Key="RainHubFlatListItem" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            One row, defined once and shared by the search results and the live signal feed.
            Row clicks are handled on the Border; code-behind ignores clicks that landed on
            the button so a single click never fires the command twice.
        -->
        <DataTemplate x:Key="RainHubSelectableRowTemplate">
            <Border Margin="0,0,0,4" Padding="10" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    MouseLeftButtonUp="SelectableRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Image Stretch="UniformToFill"
                               Source="{Binding ThumbnailUrl, Mode=OneWay, Converter={StaticResource RemoteImageConverter}, ConverterParameter=72}"
                               Visibility="{Binding HasThumbnail, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name, Mode=OneWay}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding PlayersLine, Mode=OneWay}" />
                    </StackPanel>

                    <ui:Button Grid.Column="2" VerticalAlignment="Center" Icon="ChevronRight20"
                               Content="{x:Static resources:Strings.RainHub_Servers_SelectPrompt}"
                               Click="SelectableRow_Button_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Same shape, but the trailing button carries a command from the view model. -->
        <DataTemplate x:Key="RainHubSignalRowTemplate">
            <Border Margin="0,0,0,6" Padding="12" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center"
                               Text="{Binding Icon, Mode=OneWay}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="Medium" TextWrapping="Wrap"
                                   Text="{Binding Text, Mode=OneWay}" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding Subtext, Mode=OneWay}"
                                   Visibility="{Binding HasSubtext, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <ui:Button Grid.Column="2" VerticalAlignment="Center" Icon="Server20"
                               Content="{x:Static resources:Strings.RainHub_FindServers}"
                               Command="{Binding DataContext.OpenSignalServersCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                               CommandParameter="{Binding}"
                               Visibility="{Binding HasPlaceId, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RainHubDiscoveryRowTemplate">
            <Border Margin="0,0,0,6" Padding="12" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Image Stretch="UniformToFill"
                               Source="{Binding ThumbnailUrl, Mode=OneWay, Converter={StaticResource RemoteImageConverter}, ConverterParameter=96}"
                               Visibility="{Binding HasThumbnail, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="Medium" TextWrapping="Wrap"
                                   Text="{Binding Name, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding PlayersText, Mode=OneWay}" />
                            <TextBlock Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding TrendText, Mode=OneWay}" />
                            <TextBlock Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding VisitsText, Mode=OneWay}"
                                       Visibility="{Binding HasVisits, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding Genre, Mode=OneWay}"
                                       Visibility="{Binding HasGenre, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   ToolTip="{x:Static resources:Strings.RainHub_Discovery_Score}"
                                   Text="{Binding ScoreText, Mode=OneWay}" />
                        <ui:Button Icon="Play28" IconFilled="True"
                                   Foreground="White" IconForeground="White"
                                   Appearance="Success"
                                   Content="{x:Static resources:Strings.RainHub_Discovery_Play}"
                                   Command="{Binding DataContext.PlayGameCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                   CommandParameter="{Binding}"
                                   IsEnabled="{Binding CanJoin, Mode=OneWay}" />
                        <ui:Button Margin="8,0,0,0" Icon="Server20"
                                   Content="{x:Static resources:Strings.RainHub_Discovery_FindServers}"
                                   Command="{Binding DataContext.FindServersCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Margin="8,0,0,0" Icon="Open24"
                                   ToolTip="{x:Static resources:Strings.RainHub_Discovery_Open}"
                                   Command="{Binding DataContext.OpenGameOnRainHubCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RainHubServerRowTemplate">
            <Border Margin="0,0,0,6" Padding="12" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    MouseLeftButtonUp="ServerRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Ties the details panel below back to the row it is describing. -->
                    <Border Grid.Column="0" Width="3" Margin="0,0,10,0" CornerRadius="2"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource SystemAccentColorBrush}"
                            Visibility="{Binding IsInspected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="13" FontWeight="Medium"
                                       Text="{Binding PlayersText, Mode=OneWay}" />
                            <TextBlock Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding JobIdShort, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding PingText, Mode=OneWay}" />
                            <TextBlock Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding FpsText, Mode=OneWay}" />
                            <TextBlock Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Text="{Binding FullText, Mode=OneWay}"
                                       Visibility="{Binding IsFull, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button VerticalAlignment="Center" Icon="Info20"
                                   ToolTip="{x:Static resources:Strings.RainHub_WhatAmIJoining_Title}"
                                   Command="{Binding DataContext.InspectServerCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="100"
                                   Icon="Play28" IconFilled="True"
                                   Foreground="White" IconForeground="White"
                                   Appearance="Success"
                                   Content="{x:Static resources:Strings.RainHub_Servers_Join}"
                                   Command="{Binding DataContext.JoinServerCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                   CommandParameter="{Binding}"
                                   IsEnabled="{Binding CanJoin, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:UiPage.Resources>
    <StackPanel Margin="0,0,14,14">

        <!-- Title carries a Beta marker: the RainHub integration is not finished, and the
             tab should say so before anyone relies on it. -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static resources:Strings.RainHub_Intro_Title}" FontSize="20" FontWeight="Medium" />
            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                    Background="{DynamicResource SystemFillColorCautionBrush}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White"
                           Text="{x:Static resources:Strings.RainHub_Badge_Beta}" />
            </Border>
        </StackPanel>
        <TextBlock Margin="0,4,0,12" FontSize="14" TextWrapping="Wrap"

                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static resources:Strings.RainHub_Intro_Description}" />

        <!--
            Service-wide error. Two-way on IsOpen because the close button writes back to the
            view model - a one-way binding would let the user dismiss the banner and leave
            the model still reporting an error, so the next failure would stay hidden.
        -->
        <ui:InfoBar Title="{x:Static resources:Strings.Common_Error}"
                    Message="{Binding ErrorMessage, Mode=OneWay}"

                    Severity="Error"
                    IsOpen="{Binding IsErrorOpen, Mode=TwoWay}"
                    IsClosable="True" />

        <!-- ══════════════════ NOT LINKED ══════════════════ -->
        <StackPanel Visibility="{Binding IsNotLinked, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Margin="0,8,0,0" Padding="20" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Medium"
                               Text="{x:Static resources:Strings.RainHub_Connect_Title}" />
                    <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{x:Static resources:Strings.RainHub_Connect_Description}" />

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static resources:Strings.RainHub_Connect_Step1}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static resources:Strings.RainHub_Connect_Step2}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static resources:Strings.RainHub_Connect_Step3}" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox x:Name="PairCodeBox" Grid.Column="0"
                                    PlaceholderText="{x:Static resources:Strings.RainHub_Code_Placeholder}"
                                    MaxLength="6"
                                    Text="{Binding LinkCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    KeyDown="PairCodeBox_KeyDown" />

                        <ui:Button Grid.Column="1" Margin="10,0,0,0" Appearance="Primary"
                                   VerticalAlignment="Stretch"
                                   Icon="Link20"
                                   Content="{x:Static resources:Strings.RainHub_Link_Button}"
                                   IsEnabled="{Binding CanLink, Mode=OneWay}"
                                   Command="{Binding LinkCommand}" />

                        <ui:Button Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Stretch"
                                   Icon="Globe20"
                                   Content="{x:Static resources:Strings.RainHub_Open_Website}"
                                   Command="{Binding OpenRainHubWebsiteCommand}" />
                    </Grid>

                    <ui:ProgressRing Margin="0,12,0,0" HorizontalAlignment="Left"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsLinking, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{x:Static resources:Strings.RainHub_Connect_Note}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══════════════════ LINKED ══════════════════ -->
        <StackPanel Visibility="{Binding IsLinked, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- device / account status -->
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="Medium"
                                       Text="{x:Static resources:Strings.RainHub_Connected_Title}" />

                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                    Background="{DynamicResource SystemFillColorSuccessBrush}">
                                <TextBlock FontSize="10" Foreground="White"
                                           Text="{x:Static resources:Strings.RainHub_Connected_Status}" />
                            </Border>

                            <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding DeviceIdText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Margin="0,3,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding LastHeartbeatText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Icon="ArrowSync16" Margin="0,0,10,0"
                                   Content="{x:Static resources:Strings.RainHub_Live_Refresh}"
                                   Command="{Binding RefreshAllCommand}" />
                        <ui:Button Icon="Globe20" Margin="0,0,10,0"
                                   Content="{x:Static resources:Strings.RainHub_Open_Website}"
                                   Command="{Binding OpenRainHubWebsiteCommand}" />
                        <ui:Button Icon="LinkDismiss24" Appearance="Caution"
                                   Content="{x:Static resources:Strings.RainHub_Unlink_Button}"
                                   Command="{Binding UnlinkCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Reconnect path for a credential RainHub has stopped accepting. -->
            <StackPanel Visibility="{Binding NeedsRelink, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:InfoBar Margin="0,8,0,0"
                            Title="{x:Static resources:Strings.RainHub_Relink_Title}"
                            Message="{x:Static resources:Strings.RainHub_Relink_Message}"
                            Severity="Error"
                            IsOpen="True"
                            IsClosable="False" />
                <ui:Button Margin="0,8,0,0" HorizontalAlignment="Left" Icon="Globe20"
                           Content="{x:Static resources:Strings.RainHub_Open_Devices}"
                           Command="{Binding OpenRainHubDevicesCommand}" />
            </StackPanel>

            <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{x:Static resources:Strings.RainHub_Unlink_Note}" />

            <!--
                Game picker, hoisted above the tabs. Every tab acts on the game chosen here,
                so the search box and its results exist once instead of once per tab - which
                was also what let the two copies drift apart.
            -->
            <Border Margin="0,16,0,0" Padding="16" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="Medium"
                               Text="{x:Static resources:Strings.RainHub_QuickJoin_Title}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{x:Static resources:Strings.RainHub_QuickJoin_Description}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox x:Name="GameSearchBox" Grid.Column="0" Icon="Search32"
                                    PlaceholderText="{x:Static resources:Strings.RainHub_Servers_Search_Placeholder}"
                                    Text="{Binding GameSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    KeyDown="GameSearchBox_KeyDown" />

                        <ui:Button Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Stretch"
                                   Icon="Search32"
                                   Content="{x:Static resources:Strings.RainHub_Servers_Search_Button}"
                                   IsEnabled="{Binding CanSearch, Mode=OneWay}"
                                   Command="{Binding SearchGamesCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:ProgressRing Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                        IsIndeterminate="True"
                                        Visibility="{Binding IsSearchingGames, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding SelectedGame.Name, Mode=OneWay, TargetNullValue=''}" />

                        <ComboBox Margin="16,0,0,0" VerticalAlignment="Center" Width="190"
                                  Padding="10,5,10,5"
                                  ToolTip="{x:Static resources:Strings.RainHub_QuickJoin_Preference}"
                                  ItemsSource="{Binding QuickJoinPreferences, Mode=OneTime}"
                                  SelectedItem="{Binding SelectedQuickJoinPreference, Mode=TwoWay}"
                                  Visibility="{Binding HasSelectedGame, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ui:Button Margin="10,0,0,0" Appearance="Success" Icon="Play28" IconFilled="True"
                                   Foreground="White" IconForeground="White"
                                   Content="{x:Static resources:Strings.RainHub_QuickJoin_Button}"
                                   ToolTip="{x:Static resources:Strings.RainHub_QuickJoin_Button_Description}"
                                   Command="{Binding JoinQuickCommand}"
                                   IsEnabled="{Binding HasSelectedGame, Mode=OneWay}" />
                    </StackPanel>

                    <!--
                        A ListView rather than an ItemsControl: RainHub can return hundreds of
                        servers, and only a virtualizing host keeps that from building every
                        row's visual tree at once.
                    -->
                    <ListView MaxHeight="220" Margin="0,10,0,0"
                              ItemsSource="{Binding SearchResults, Mode=OneWay}"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Visibility="{Binding HasSearchResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <StaticResource ResourceKey="RainHubFlatListItem" />
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <StaticResource ResourceKey="RainHubSelectableRowTemplate" />
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <TabControl Margin="0,16,0,0" Background="Transparent" BorderThickness="0">

                <!-- ─────────── SERVERS ─────────── -->
                <TabItem Header="{x:Static resources:Strings.RainHub_Tab_Servers}">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock FontSize="16" FontWeight="Medium"
                                   Text="{x:Static resources:Strings.RainHub_Servers_Title}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static resources:Strings.RainHub_Servers_Description}" />

                        <Grid Margin="0,12,0,0" Visibility="{Binding HasSelectedGame, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" VerticalAlignment="Center" Width="170"
                                      Padding="10,5,10,5"
                                      ToolTip="{x:Static resources:Strings.RainHub_Servers_Filter}"
                                      ItemsSource="{Binding ServerFilterLabels, Mode=OneTime}"
                                      SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}" />

                            <ComboBox Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Width="170"
                                      Padding="10,5,10,5"
                                      ToolTip="{x:Static resources:Strings.RainHub_Servers_Sort}"
                                      ItemsSource="{Binding ServerSortLabels, Mode=OneTime}"
                                      SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}" />

                            <ui:Button Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Icon="ArrowSync16"
                                       Content="{x:Static resources:Strings.RainHub_Servers_Refresh}"
                                       IsEnabled="{Binding CanRefreshServers, Mode=OneWay}"
                                       Command="{Binding RefreshServersCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:ProgressRing Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                            IsIndeterminate="True"
                                            Visibility="{Binding IsLoadingServers, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ServersCountText, Mode=OneWay}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding ServersEmptyText, Mode=OneWay}" />
                        </StackPanel>

                        <ListView MaxHeight="420" Margin="0,8,0,0"
                                  ItemsSource="{Binding Servers, Mode=OneWay}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  Visibility="{Binding HasServers, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListView.ItemContainerStyle>
                                <StaticResource ResourceKey="RainHubFlatListItem" />
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <StaticResource ResourceKey="RainHubServerRowTemplate" />
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- What am I joining? Only real RainHub/Roblox values, never estimates. -->
                        <Border Margin="0,10,0,0" Padding="14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Medium"
                                           Text="{x:Static resources:Strings.RainHub_WhatAmIJoining_Title}" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{x:Static resources:Strings.RainHub_WhatAmIJoining_Description}" />

                                <!-- Empty state, so it is bound to the inverse of the selection. -->
                                <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding WhatAmIJoiningEmptyText, Mode=OneWay}"
                                           Visibility="{Binding HasNoSelectedServer, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <StackPanel Visibility="{Binding HasSelectedServer, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl Margin="0,10,0,0"
                                                  ItemsSource="{Binding SelectedServer.Details, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding Label, Mode=OneWay}" />
                                                    <TextBlock Grid.Column="1" FontSize="11" FontFamily="{StaticResource CascadiaCode}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Value, Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ui:Button Margin="0,12,0,0" HorizontalAlignment="Left" MinWidth="140"
                                               Icon="Play28" IconFilled="True"
                                               Foreground="White" IconForeground="White"
                                               Appearance="Success"
                                               Content="{x:Static resources:Strings.RainHub_Servers_Join}"
                                               Command="{Binding JoinServerCommand, Mode=OneWay}"
                                               CommandParameter="{Binding SelectedServer, Mode=OneWay}"
                                               IsEnabled="{Binding SelectedServer.CanJoin, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ─────────── DISCOVERY ─────────── -->
                <TabItem Header="{x:Static resources:Strings.RainHub_Tab_Discovery}">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock FontSize="16" FontWeight="Medium"
                                   Text="{x:Static resources:Strings.RainHub_Discovery_Title}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static resources:Strings.RainHub_Discovery_Description}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:ProgressRing Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                            IsIndeterminate="True"
                                            Visibility="{Binding IsLoadingDiscovery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button Icon="ArrowSync16"
                                       Content="{x:Static resources:Strings.RainHub_Discovery_Refresh}"
                                       Command="{Binding RefreshDiscoveryCommand}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding DiscoverySummaryText, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding DiscoveryGenresText, Mode=OneWay}"
                                   Visibility="{Binding HasDiscoveryGenres, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding DiscoveryEmptyText, Mode=OneWay}"
                                   Visibility="{Binding HasNoDiscoveryGames, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ListView MaxHeight="480" Margin="0,8,0,0"
                                  ItemsSource="{Binding DiscoveryGames, Mode=OneWay}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  Visibility="{Binding HasDiscoveryGames, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListView.ItemContainerStyle>
                                <StaticResource ResourceKey="RainHubFlatListItem" />
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <StaticResource ResourceKey="RainHubDiscoveryRowTemplate" />
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </StackPanel>
</ui:UiPage>
