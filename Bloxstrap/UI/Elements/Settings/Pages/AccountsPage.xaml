<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="AccountsPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_Accounts_Title}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,4,0,12" Text="{x:Static resources:Strings.Menu_Accounts_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:InfoBar Title="{x:Static resources:Strings.Common_Warning}"
                    Message="{x:Static resources:Strings.Accounts_CookieAccessDisabled}"
                    Severity="Warning"
                    IsOpen="{Binding CookieAccessDisabled, Mode=OneWay}"
                    IsClosable="False" />

        <ui:InfoBar Title="{x:Static resources:Strings.Common_Error}"
                    Message="{Binding ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    IsOpen="{Binding ErrorVisibility, Mode=OneWay}"
                    IsClosable="False" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Appearance="Primary" Icon="Add20" Content="{x:Static resources:Strings.Accounts_AddAccount}" Command="{Binding AddAccountCommand}" IsEnabled="{Binding AddAccountEnabled, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding LoadingVisibility, Mode=OneWay}">
                <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" />
                <TextBlock Margin="8,2,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Loading}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,8,0,0" Text="{x:Static resources:Strings.Accounts_AddHint}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />

        <!-- empty state -->
        <Border Margin="0,16,0,0" Padding="24" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Visibility="{Binding EmptyStateVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="PersonCircle24" FontSize="42" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="Medium" Text="{x:Static resources:Strings.Accounts_EmptyTitle}" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{x:Static resources:Strings.Accounts_EmptyDescription}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- account cards -->
        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Accounts, Mode=OneWay}" x:Name="AccountsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Image Source="{Binding AvatarImage, Mode=OneWay}" Width="44" Height="44" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="14" FontWeight="Medium" Text="{Binding Title, Mode=OneWay}" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Visibility="{Binding ActiveBadgeVisibility, Mode=OneWay}" Background="{DynamicResource SystemFillColorSuccessBrush}">
                                        <TextBlock FontSize="11" Text="{x:Static resources:Strings.Accounts_Active}" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="12" Text="{Binding Username, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock FontSize="11" Text="{Binding LastUsedText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Margin="0,0,6,0" Content="{x:Static resources:Strings.Accounts_SetActive}"
                                           Command="{Binding DataContext.ActivateAccountCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                           CommandParameter="{Binding Id}"
                                           Visibility="{Binding SetActiveButtonVisibility, Mode=OneWay}" />
                                <ui:Button Margin="0,0,6,0" Icon="Edit16"
                                           Command="{Binding DataContext.RenameAccountCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                           CommandParameter="{Binding Id}" />
                                <ui:Button Margin="0,0,6,0" Icon="Delete16"
                                           Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                           CommandParameter="{Binding Id}" />
                                <ui:Button Appearance="Primary" Content="{Binding LaunchButtonText, Mode=OneWay}"
                                           Command="{Binding DataContext.LaunchAccountCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                           CommandParameter="{Binding Id}"
                                           IsEnabled="{Binding DataContext.LaunchButtonsEnabled, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,8,0,0" Text="{x:Static resources:Strings.Accounts_SwitchNote}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
    </StackPanel>
</ui:UiPage>
