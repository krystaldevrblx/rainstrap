<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.UpdatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="UpdatesPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <!-- Roblox updates section -->
        <TextBlock Text="{x:Static resources:Strings.Updates_Title}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,4,0,12" Text="{x:Static resources:Strings.Updates_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:InfoBar Title="{x:Static resources:Strings.Common_Error}"
                    Message="{Binding ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    IsOpen="{Binding ErrorVisibility, Mode=OneWay}"
                    IsClosable="False" />

        <!-- version status card -->
        <Border Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="16" FontWeight="Medium" Text="{Binding StatusTitle, Mode=OneWay}" />
                    <!-- Marks a result that was restored from disk rather than
                         produced by a check in this session, so a saved answer is
                         never read as a fresh one. -->
                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,2" CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}"
                            Visibility="{Binding RestoredBadgeVisibility, Mode=OneWay}">
                        <TextBlock FontSize="11" Text="{Binding RestoredBadgeText, Mode=OneWay}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </Grid>
                <TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding StatusDescription, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:OptionControl Grid.Column="0"
                Header="{x:Static resources:Strings.Updates_CurrentVersion}"
                Description="{Binding CurrentVersionText, Mode=OneWay}" />

            <ui:Button Grid.Column="1" Appearance="Primary" Icon="ArrowSync16" MinWidth="140"
                       Content="{Binding CheckButtonText, Mode=OneWay}"
                       Command="{Binding CheckForUpdatesCommand}"
                       IsEnabled="{Binding CheckNowEnabled, Mode=OneWay}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Updates_AvailableVersion}"
            Description="{Binding AvailableVersionText, Mode=OneWay}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Updates_LastCheckedLabel}"
            Description="{Binding LastCheckedText, Mode=OneWay}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Updates_LatencyLabel}"
            Description="{Binding ApiLatencyText, Mode=OneWay}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Updates_CurrentChannel}"
            Description="{Binding ChannelText, Mode=OneWay}" />

        <TextBlock Margin="0,16,0,0" Text="{x:Static resources:Strings.Updates_BehaviorHeader}" FontSize="20" FontWeight="Medium" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Updates_UpgradeMode_Title}"
            Description="{x:Static resources:Strings.Updates_UpgradeMode_Description}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="220"
                      ItemsSource="{Binding UpgradeModes.Keys, Mode=OneTime}"
                      SelectedItem="{Binding SelectedUpgradeMode, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <ui:InfoBar Margin="0,12,0,0"
                    Title="{x:Static resources:Strings.Common_Note}"
                    Message="{x:Static resources:Strings.Updates_ForcedNote}"
                    Severity="Warning"
                    IsOpen="True"
                    IsClosable="False" />

        <!-- version history: a read-only record of what this device installed.
             Choosing which version to use is Version Control's job, so there is
             deliberately no action on these rows. -->
        <TextBlock Margin="0,24,0,0" Text="{x:Static resources:Strings.Updates_History_Header}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,4,0,8" Text="{x:Static resources:Strings.Updates_History_Description}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <TextBlock Margin="0,4,0,0"
                   Text="{x:Static resources:Strings.Updates_History_Empty}"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HistoryEmptyVisibility, Mode=OneWay}" />

        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding RecentVersions, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="12" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding DisplayVersion, Mode=OneWay}" VerticalAlignment="Center" />
                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource SystemFillColorSuccessBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" Text="{Binding StateBadgeText, Mode=OneWay}" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock FontSize="11" Text="{Binding VersionGuid, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Text="{Binding InstalledText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>