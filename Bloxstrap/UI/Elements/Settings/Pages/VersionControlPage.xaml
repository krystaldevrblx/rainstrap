<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.VersionControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="VersionControlPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">

        <TextBlock Text="{x:Static resources:Strings.VersionControl_Title}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,4,0,12" Text="{x:Static resources:Strings.VersionControl_Description}"
                   FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <ui:InfoBar Title="{x:Static resources:Strings.Common_Error}"
                    Message="{Binding ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    IsOpen="{Binding ErrorVisibility, Mode=OneWay}"
                    IsClosable="False" />

        <!-- selected version + refresh -->
        <Border Padding="16" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Text="{x:Static resources:Strings.VersionControl_SelectedVersion}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="Medium"
                               Text="{Binding SelectedVersionText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Text="{Binding LastRefreshedText, Mode=OneWay}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ui:Button MinWidth="150" Margin="0,0,8,0"
                               Content="{Binding RefreshButtonText, Mode=OneWay}"
                               Command="{Binding RefreshCommand}"
                               IsEnabled="{Binding RefreshEnabled, Mode=OneWay}" />
                    <ui:Button MinWidth="130"
                               Content="{x:Static resources:Strings.VersionControl_Action_FollowChannel}"
                               Command="{Binding FollowChannelCommand}"
                               Visibility="{Binding CanFollowChannel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Honest statement about coverage. Roblox publishes no endpoint that
             enumerates historical versions, so this list is never exhaustive and
             says so instead of implying otherwise. -->
        <ui:InfoBar Margin="0,12,0,0"
                    Title="{x:Static resources:Strings.Common_Note}"
                    Message="{Binding LimitationText, Mode=OneWay}"
                    Severity="Informational"
                    IsOpen="{Binding LimitationVisibility, Mode=OneWay}"
                    IsClosable="False" />

        <ui:InfoBar Margin="0,12,0,0"
                    Title="{x:Static resources:Strings.Common_Note}"
                    Message="{x:Static resources:Strings.VersionControl_AgeWarning}"
                    Severity="Warning"
                    IsOpen="True"
                    IsClosable="False" />

        <TextBlock Margin="0,4,0,8"
                   Text="{x:Static resources:Strings.VersionControl_Empty}"
                   FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                   Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Versions, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="12" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="14" FontWeight="Medium" Text="{Binding DisplayVersion, Mode=OneWay}" VerticalAlignment="Center" />

                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemFillColorSuccessBrush}"
                                            Visibility="{Binding SelectedBadgeVisibility, Mode=OneWay}">
                                        <TextBlock FontSize="11" Foreground="White" Text="{x:Static resources:Strings.VersionControl_Badge_Selected}" />
                                    </Border>

                                    <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}"
                                            Visibility="{Binding LatestBadgeVisibility, Mode=OneWay}">
                                        <TextBlock FontSize="11" Text="{x:Static resources:Strings.VersionControl_Badge_Latest}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}"
                                            Visibility="{Binding InstalledBadgeVisibility, Mode=OneWay}">
                                        <TextBlock FontSize="11" Text="{x:Static resources:Strings.VersionControl_Badge_Installed}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Margin="0,4,0,0" FontSize="11" Text="{Binding AvailabilityText, Mode=OneWay}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Margin="0,2,0,0" FontSize="11" Text="{Binding SupportText, Mode=OneWay}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <ui:Button MinWidth="100" Margin="0,0,6,0"
                                           Content="{x:Static resources:Strings.VersionControl_Action_Select}"
                                           Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                           CommandParameter="{Binding}"
                                           IsEnabled="{Binding SelectEnabled, Mode=OneWay}"
                                           Visibility="{Binding SelectButtonVisibility, Mode=OneWay}" />

                                <ui:Button MinWidth="100" Margin="0,0,6,0"
                                           Content="{Binding DownloadButtonText, Mode=OneWay}"
                                           Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                           CommandParameter="{Binding}"
                                           IsEnabled="{Binding DownloadEnabled, Mode=OneWay}"
                                           Visibility="{Binding DownloadButtonVisibility, Mode=OneWay}" />

                                <ui:Button MinWidth="100" Margin="0,0,6,0" Appearance="Caution"
                                           Content="{x:Static resources:Strings.VersionControl_Action_Remove}"
                                           Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                           CommandParameter="{Binding}"
                                           Visibility="{Binding RemoveButtonVisibility, Mode=OneWay}" />

                                <ui:Button MinWidth="40" Icon="Info16" ToolTip="{x:Static resources:Strings.VersionControl_Action_Details}"
                                           Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>